#!/usr/bin/env python3
"""snapper-helper - snapper bridge for the snapper Omarchy plugin.

Talks to snapperd through the `snapper` CLI as the calling user, which needs
ALLOW_USERS to include that user in each snapper config. All output is a
single JSON document on stdout; failures exit non-zero with {"ok": false, ...}.

Commands:
  status                   List snapshots across snapper configs with sizes
  create <description>     Create a number-cleanup snapshot in every config
  delete <config> <number> Delete one snapshot from one config
  cleanup                  Run `snapper cleanup number` for every config
  quota-enable             Enable btrfs quotas on / (root only, via pkexec)

Never invoked with shell interpolation: the QML side always passes argv.
"""

import json
import os
import shutil
import subprocess
import sys

LIST_COLUMNS = "number,type,pre-number,date,user,cleanup,description,userdata,used-space"


def fail(msg):
    print(json.dumps({"ok": False, "error": msg}))
    sys.exit(1)


def run(cmd):
    p = subprocess.run(cmd, capture_output=True, text=True)
    return p.returncode, p.stdout, p.stderr


def snapper(args):
    rc, out, err = run(["snapper", *args])
    if rc != 0:
        fail("snapper %s failed: %s" % (" ".join(args), err.strip() or out.strip()))
    return out


def snapper_configs():
    doc = json.loads(snapper(["--jsonout", "list-configs"]))
    return [c["config"] for c in doc.get("configs", [])]


def cmd_status():
    configs = snapper_configs()
    snapshots = []
    for config in configs:
        doc = json.loads(snapper(["--jsonout", "-c", config, "list", "--columns", LIST_COLUMNS]))
        for s in doc.get(config, []):
            # Snapshot 0 is snapper's stand-in for the live filesystem.
            if s["number"] == 0:
                continue
            snapshots.append({
                "number": s["number"],
                "config": config,
                "type": s["type"],
                "pre_number": s.get("pre-number"),
                "date": s.get("date", ""),
                "user": s.get("user", ""),
                "cleanup": s.get("cleanup", ""),
                "description": s.get("description", ""),
                "size": s.get("used-space"),
            })
    snapshots.sort(key=lambda s: s["number"], reverse=True)

    # snapper reports used-space only while btrfs quotas are on.
    sizes = [s["size"] for s in snapshots if s["size"] is not None]
    du = shutil.disk_usage("/")
    print(json.dumps({
        "ok": True,
        "configs": configs,
        "snapshots": snapshots,
        "quota_enabled": bool(sizes),
        "total_exclusive_bytes": sum(sizes),
        "fs": {"total": du.total, "used": du.used, "free": du.free},
    }))


def cmd_create(args):
    if len(args) != 1:
        fail("create needs a description")
    configs = snapper_configs()
    if not configs:
        fail("no snapper configs found")
    created = []
    for config in configs:
        out = snapper(["-c", config, "create", "-c", "number",
                       "--description", args[0], "--print-number"])
        created.append({"config": config, "number": int(out.strip() or 0) or None})
    print(json.dumps({"ok": True, "created": created}))


def cmd_delete(args):
    if len(args) != 2 or not args[1].isdigit() or int(args[1]) == 0:
        fail("delete needs a config name and a snapshot number")
    config, number = args
    if config not in snapper_configs():
        fail("unknown snapper config: %s" % config)
    snapper(["-c", config, "delete", number])
    print(json.dumps({"ok": True, "config": config, "number": int(number)}))


def cmd_cleanup():
    configs = snapper_configs()
    for config in configs:
        snapper(["-c", config, "cleanup", "number"])
    print(json.dumps({"ok": True, "configs": configs}))


def cmd_quota_enable():
    if os.geteuid() != 0:
        fail("quota-enable must run as root")
    rc, out, err = run(["btrfs", "quota", "enable", "/"])
    if rc != 0:
        fail("btrfs quota enable failed: %s" % (err.strip() or out.strip()))
    print(json.dumps({"ok": True}))


def main(argv):
    if len(argv) < 2:
        fail("usage: snapper-helper <status|create|delete|cleanup|quota-enable> [args]")
    cmd, rest = argv[1], argv[2:]
    if cmd == "status":
        cmd_status()
    elif cmd == "create":
        cmd_create(rest)
    elif cmd == "delete":
        cmd_delete(rest)
    elif cmd == "cleanup":
        cmd_cleanup()
    elif cmd == "quota-enable":
        cmd_quota_enable()
    else:
        fail("unknown command: %s" % cmd)


if __name__ == "__main__":
    main(sys.argv)
