{
  "schemaVersion": 1,
  "id": "videinfra.omasnapper",
  "name": "omasnapper",
  "version": "0.1.0",
  "author": "thevideinfra",
  "license": "MIT",
  "description": "See, take, delete and restore Btrfs snapshots from the Omarchy bar, with who made each one and why.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "allowMultiple": false,
    "category": "System",
    "defaultSection": "right",
    "defaults": {
      "density": "normal",
      "fontSize": "normal",
      "refreshIntervalSec": 300,
      "warnThresholdGB": 5,
      "showRetention": true
    },
    "description": "System snapshots: why each was made, one-click snapshot, restore and delete",
    "displayName": "omasnapper",
    "schema": [
      {
        "key": "density",
        "type": "enum",
        "label": "Density",
        "options": [
          "compact",
          "normal",
          "comfortable"
        ],
        "defaultValue": "normal",
        "description": "How tightly the panel is laid out."
      },
      {
        "key": "fontSize",
        "type": "enum",
        "label": "Font size",
        "options": [
          "small",
          "normal",
          "large"
        ],
        "defaultValue": "normal",
        "description": "Text size, on top of the density's own scaling."
      },
      {
        "key": "showRetention",
        "type": "boolean",
        "label": "Show the retention section",
        "defaultValue": true
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 60,
        "max": 3600,
        "step": 60,
        "defaultValue": 300
      },
      {
        "key": "warnThresholdGB",
        "type": "integer",
        "label": "Warn when snapshots hold more than this (GB)",
        "min": 1,
        "max": 100,
        "step": 1,
        "defaultValue": 5,
        "description": "Needs btrfs quotas."
      }
    ]
  }
}
